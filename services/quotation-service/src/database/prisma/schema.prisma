generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String   @id @default(uuid())
  companyCode        String   @unique
  name               String   @unique
  subscriptionStatus String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  users     User[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String
  lastName     String?
  mobileNumber String?
  isActive     Boolean  @default(true)
  roleId       String
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id])
  role         Role     @relation(fields: [roleId], references: [id])
}

model OptionalServiceCatalog {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(false) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("optional_service_catalog")
}

model Quotation {
  id                     String    @id @default(uuid())
  quotationNumber        String    @unique @map("quotation_number")
  companyId              String    @map("company_id")
  companyName            String    @map("company_name")
  contactPerson          String?   @map("contact_person")
  contactEmail           String    @map("contact_email")
  contactPhone           String?   @map("contact_phone")
  status                 String    @default("PENDING_REVIEW")
  tier                   String    @default("Enterprise")
  machineCount           Int       @default(1) @map("machine_count")
  contractDuration       String    @default("12") @map("contract_duration")
  billingFrequency       String    @default("Monthly in Advance") @map("billing_frequency")
  baseAmount             Decimal   @default(0) @map("base_amount") @db.Decimal(12, 2)
  optionalServicesAmount Decimal   @default(0) @map("optional_services_amount") @db.Decimal(12, 2)
  discountAmount         Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount              Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount            Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  optionalServices       Json      @default("[]") @map("optional_services")
  scopeOfWork            Json?     @map("scope_of_work")
  paymentTerms           String?   @map("payment_terms")
  notes                  String?
  validUntil             DateTime? @map("valid_until")
  sentAt                 DateTime? @map("sent_at")
  acceptedAt             DateTime? @map("accepted_at")
  rejectedAt             DateTime? @map("rejected_at")
  signedBy               String?   @map("signed_by")
  signatureUrl           String?   @map("signature_url")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("quotations")
}

model QuotationInquiry {
  id                         String    @id @default(uuid())
  inquiryId                  String    @unique @map("inquiry_id")
  companyId                  String    @map("company_id")
  companyName                String    @map("company_name")
  contactPerson              String?   @map("contact_person")
  email                      String
  phone                      String?
  siteLocation               String?   @map("site_location")
  quotationType              String    @map("quotation_type")
  numberOfSites              Int       @default(1) @map("number_of_sites")
  siteNames                  Json      @default("[]") @map("site_names")
  activeMachines             Int       @default(1) @map("active_machines")
  equipmentTypes             Json      @default("[]") @map("equipment_types")
  contractDuration           String    @default("12 Months") @map("contract_duration")
  implementationRequirements String?   @map("implementation_requirements")
  additionalRequirements     String?   @map("additional_requirements")
  attachmentUrl              String?   @map("attachment_url")
  attachmentFileName         String?   @map("attachment_file_name")
  attachmentFileType         String?   @map("attachment_file_type")
  attachmentSize             Int?      @map("attachment_size")
  status                     String    @default("ACTIVE")
  quotationStatus            String?   @map("quotation_status")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("quotation_inquiries")
}

model QuotationRequest {
  id                         String    @id @default(uuid())
  requestId                  String    @unique @map("request_id")
  userId                     String?   @map("user_id")
  companyId                  String?   @map("company_id")
  companyName                String?   @map("company_name")
  contactPerson              String?   @map("contact_person")
  email                      String?
  phone                      String?
  siteLocation               String?   @map("site_location")
  quotationType              String    @map("quotation_type")
  numberOfSites              Int       @default(1) @map("number_of_sites")
  siteNames                  Json      @default("[]") @map("site_names")
  activeMachines             Int       @default(1) @map("active_machines")
  equipmentTypes             Json      @default("[]") @map("equipment_types")
  contractDuration           String    @default("12 Months") @map("contract_duration")
  optionalServices           Json      @default("[]") @map("optional_services")
  implementationRequirements String?   @map("implementation_requirements")
  additionalRequirements     String?   @map("additional_requirements")
  attachmentUrl              String?   @map("attachment_url")
  attachmentFileName         String?   @map("attachment_file_name")
  attachmentFileType         String?   @map("attachment_file_type")
  attachmentSize             Int?      @map("attachment_size")
  status                     String    @default("PENDING")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@map("quotation_requests")
}

